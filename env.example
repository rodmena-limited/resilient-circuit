# Circuit-breaker state storage.
#
# Option A (recommended) — a complete libpq conninfo or postgresql:// URL, used
# verbatim. This is the ONLY form that can express TLS options, so it is required
# for any server that mandates sslmode=verify-full or client-certificate auth.
# RC_DB_DSN=postgresql://user:pass@db.example:5432/appdb?sslmode=verify-full&sslrootcert=/etc/ssl/cert.pem&sslcert=/etc/tls/client.crt&sslkey=/etc/tls/client.key

# Option B — discrete variables. Both RC_DB_HOST and RC_DB_PASSWORD must be set
# for PostgreSQL storage to be selected; otherwise storage is in-memory.
RC_DB_HOST=localhost
RC_DB_PORT=5432
RC_DB_NAME=resilient_circuit_db
RC_DB_USER=postgres
RC_DB_PASSWORD=postgres

# Optional TLS for Option B (omit entirely for plaintext/local sockets).
# RC_DB_SSLMODE=verify-full
# RC_DB_SSLROOTCERT=/etc/ssl/cert.pem
# RC_DB_SSLCERT=/etc/tls/client.crt
# RC_DB_SSLKEY=/etc/tls/client.key

# Isolate breaker state between services or test runs sharing one database.
# RC_NAMESPACE=default
